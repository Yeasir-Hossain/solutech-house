# MongoDB Atlas connection string (leads storage)
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?appName=house"
MONGODB_DB="solutechhouse"

# Admin area (/admin) credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie.
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (used for canonical URLs, OG tags and the sitemap)
NEXT_PUBLIC_SITE_URL="https://www.webuyanyhouse.co.uk"
